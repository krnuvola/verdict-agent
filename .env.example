# Copy to .env; replace placeholders locally. Never commit actual credentials.
# LLM replay and peer selection are independent; neither mode creates fixtures.
GBA_ENV=dev
SERVICE_TOKEN=replace-me
DATABASE_URL=postgresql+psycopg://gba:replace-me@localhost:5433/agentdb
AGENTDB_USER=gba
AGENTDB_PASSWORD=replace-me
AGENT_API_URL=http://localhost:8100
GRAPH_API_URL=http://localhost:8101
WORKBENCH_API_URL=http://localhost:8102
PEER_MODE=live
# Use PEER_MODE=mock only with the explicitly started development mock servers.
GRAPH_MOCK_API_URL=http://localhost:18101
WORKBENCH_MOCK_API_URL=http://localhost:18102
PEER_REPLAY_DIR=./.peer_replay
BLOB_URL=file://./.blobs
BLOB_S3_KEY=gba-local
BLOB_S3_SECRET=replace-me
LLM_PROVIDER=openai_compatible
LLM_API_KEY=replace-me
LLM_BASE_URL=http://localhost:4000/v1
LLM_MODEL_PLANNER=replace-me
LLM_MODEL_EXTRACTOR=replace-me
LLM_MODEL_JUDGE=replace-me-different-from-planner
LLM_MODEL_VLM=
LLM_MODEL_DRAFTER=
LLM_CACHE_DIR=./.llm_cache
LLM_MODE=replay
TRAJ_DIR=./trajectory
REGISTRY_PATH=./config/registry.yaml
AGENT_USER_AGENT="GuardedLegalAgent/1.0 (contact: replace-with-contact@example.com)"
AS_OF_LEAKAGE_MODE=strict
GBA_CA_BUNDLE=
COURTLISTENER_TOKEN=
SESSION_DIR=./.sessions
SESSION_ENC_KEY=
BROWSER_MODE=headless
NOVNC_BASE_URL=http://localhost:6080
HANDOFF_TIMEOUT_SECONDS=900
VAULT_BACKEND=none
VAULT_FILE=
VAULT_FILE_KEY=
SUPPORT_JUDGE=llm
SUPPORT_MIN_SCORE=0.7
NLI_MODEL=cross-encoder/nli-deberta-v3-base
MAX_GNN_LOOPS=2
ABSTAIN_MIN_CONFIDENCE=0
ABSTAIN_CALIBRATOR_PATH=./abstention_calibrator.json
ALLOW_UNREGISTERED_FETCH_FOR_BASELINE=false
SPEND_CAP_USD=0
LLM_PRICE_TABLE_JSON={}
PLAYBOOK_DIR=./playbooks
